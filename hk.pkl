amends "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Builtins.pkl"

// usageMsg reports why USAGE.md must not be edited and exits non-zero. It is shared by
// the no-usage-md step's check and fix so that `hk fix`, which the pre-commit hook runs,
// doesn't silently let the edit through.
local usageMsg = """
echo "USAGE.md is generated by scripts/generate-usage.sh and regenerated by CI on every pull request, so an edit here is overwritten. Don't edit it. See CONTRIBUTING.md." >&2
exit 1
"""

local linters = new Mapping<String, Step> {
  ["golangci-lint"] = Builtins.golangci_lint
  ["gomod-tidy"] = Builtins.gomod_tidy
  ["typos"] = (Builtins.typos) {
    fix = check
  }
  // ["lychee"] = Builtins.lychee
  ["nllint"] {
    glob = List("**/*")
    check = "nllint -s {{files}}"
    fix = "nllint -s -f {{files}}"
    batch = true
  }
  ["go-test"] {
    glob = List("go.mod", "go.sum", "**/*.go")
    check = "go test -race -covermode=atomic ./..."
    fix = "go test -race -covermode=atomic ./..." // run as check in fix mode (no real fix possible)
    batch = true
  }
  ["langcheck"] {
    // https://github.com/suzuki-shunsuke/langcheck
    glob = List("**/*")
    check = "langcheck check {{files}}"
    fix = "langcheck check {{files}}" // run as check in fix mode (no real fix possible)
    batch = true
  }
  // USAGE.md is generated by scripts/generate-usage.sh from the released binary, and CI
  // regenerates it on every pull request. Editing it by hand is always undone, so this
  // fails as soon as it is staged rather than after the round trip through CI.
  // The glob makes it run only when USAGE.md is one of the files, so there is nothing to
  // check otherwise and nothing to fix when there is.
  ["no-usage-md"] {
    glob = List("USAGE.md")
    check = usageMsg
    fix = usageMsg
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["commit-msg"] {
    steps {
      ["langcheck"] {
        // https://github.com/suzuki-shunsuke/langcheck
        check = "langcheck check {{commit_msg_file}}"
      }
    }
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
